# Postgres connection string
DATABASE_URL="postgres://user:password@host:5432/db-name"

# Public origin of the app, e.g. http://localhost:5173
ORIGIN=""

# Better Auth: at least 32 high-entropy characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# SMTP, used for password reset emails
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
